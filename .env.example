DATABASE_URL="file:./dev.db"
ADMIN_PASSWORD="change-me-to-something-long-and-secret"

# Production (Turso) — only needed on Vercel, or locally to test against Turso.
# Get the token with: turso db tokens create <your-db-name>
TURSO_DATABASE_URL="libsql://<your-db>.<region>.turso.io"
TURSO_AUTH_TOKEN="<paste-token-here>"
