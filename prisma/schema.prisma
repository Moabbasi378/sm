generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DateResponse {
  id             String   @id @default(cuid())
  date           String
  time           String
  location       String
  locationCustom String?
  transportation String
  notes          String?
  createdAt      DateTime @default(now())

  @@map("date_responses")
}
